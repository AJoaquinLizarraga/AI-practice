# ---------------------------------------------------------------
# Copia este archivo a `.env` y rellena tu API key
#   cp .env.example .env
# ---------------------------------------------------------------

# Tu API key de Pinecone (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre del índice que se creará. Puedes dejarlo así.
PINECONE_INDEX=demo-rag

# Namespace: una "carpeta" lógica dentro del índice para separar datos.
PINECONE_NAMESPACE=manual-empresa

# Modelo de embeddings alojado por Pinecone (gratis dentro del free tier).
# Opciones: llama-text-embed-v2 | multilingual-e5-large
PINECONE_EMBED_MODEL=multilingual-e5-large

# ---------------------------------------------------------------
# Ollama (LLM local). Asegúrate de tener el modelo descargado:
#   ollama pull gemma4:12b
# ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
